# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo playback fixtures (public test streams, no credentials)
DEMO_HLS_PRIMARY=
DEMO_HLS_SECONDARY=

# Player library (defaults to a pinned CDN build, override with a self hosted copy)
NEXT_PUBLIC_HLS_JS_URL=

# Real provider playback stays disabled until credential rotation is complete
ENABLE_REAL_PROVIDERS=false

# Admin API protection. When empty the admin API runs in local demo mode.
ADMIN_API_TOKEN=

# Supabase (optional in the MVP, required for accounts and persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
